{
  "name": "react-three-texture",
  "author": "Jorg Nieberg",
  "description": "Live texture editing tool for ThreeJS and React Three Fiber",
  "license": "MIT",
  "version": "1.2.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": false
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnieberg/react-three-texture.git"
  },
  "keywords": [
    "texture",
    "3d",
    "layers",
    "material",
    "image",
    "canvas",
    "threejs",
    "react",
    "three",
    "fiber",
    "r3f",
    "tool",
    "blending",
    "effect",
    "gradient"
  ],
  "dependencies": {
    "color-string": "^2.1.4"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9.6.1",
    "react": ">=19.0.0",
    "three": ">=0.185.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/jnieberg/react-three-texture/issues"
  },
  "homepage": "https://github.com/jnieberg/react-three-texture#readme"
}
