{
  "name": "react-three-texture",
  "author": "Jorg Nieberg",
  "description": "Live texture editing tool for ThreeJS and React Three Fiber",
  "license": "MIT",
  "version": "1.2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": false
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnieberg/react-three-texture.git"
  },
  "keywords": [
    "texture",
    "3d",
    "layers",
    "material",
    "image",
    "canvas",
    "threejs",
    "react",
    "three",
    "fiber",
    "r3f",
    "tool",
    "blending",
    "effect",
    "gradient"
  ],
  "dependencies": {
    "color-string": "^1.9.1"
  },
  "devDependencies": {
    "@react-three/fiber": "^8.17.14",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.174.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.174.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8.0.0",
    "react": ">=18.0.0",
    "three": ">=0.140.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --shims",
    "dev": "tsup src/index.ts --format cjs,esm --dts --shims --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/jnieberg/react-three-texture/issues"
  },
  "homepage": "https://github.com/jnieberg/react-three-texture#readme"
}
